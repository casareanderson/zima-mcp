# zima-mcp settings. Copy to .env (or put them in your MCP client's "env" block).
# Required: the box and the SSH user. The user must be able to run `docker` without sudo.
ZIMA_HOST=192.0.2.10
ZIMA_USER=zima
# Optional
ZIMA_SSH_PORT=22
# ZIMA_SSH_KEY=/home/you/.ssh/id_ed25519
ZIMA_SSH_TIMEOUT=20
# Containers the agent may restart, comma-separated. Empty = restarts are refused.
ZIMA_RESTART_ALLOWLIST=immich-server,immich-machine-learning
